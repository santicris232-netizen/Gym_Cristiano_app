# Copy this file to .env (for `prisma` CLI / plain `next dev`) and/or to
# .dev.vars (for `next dev` with Cloudflare bindings / `opennextjs-cloudflare preview`).

# Postgres connection string (Neon). Get one free at https://neon.tech —
# create a project, copy the "Connection string" (use the pooled one).
DATABASE_URL="postgresql://user:password@ep-example-123456.region.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign/verify session JWTs — use a long random string in any real deployment
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET="changeme-generate-a-long-random-secret"
