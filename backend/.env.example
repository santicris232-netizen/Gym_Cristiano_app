# Copiá este archivo a backend/.env y ajustá lo que haga falta.
# Todos los valores ya tienen un default razonable para desarrollo local
# (ver app/config.py) — este archivo es opcional.

DATABASE_URL=sqlite:///./gym.db

# Generá una clave propia con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
